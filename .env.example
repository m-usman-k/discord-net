# Copy to .env and fill in YOUR OWN values. NEVER commit the real .env.

# OpenCode Zen API key (https://opencode.ai/zen/v1)
# NOTE: The real key goes in .env (gitignored), not here.
LLM_API_KEY=

# Leave these unless you know what you're doing
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=deepseek-v4-flash

# Optional: path to the config file (defaults to ./config.json)
CONFIG_PATH=config.json